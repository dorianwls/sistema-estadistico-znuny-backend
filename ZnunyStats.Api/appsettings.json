{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Znuny": ""
  },
  "AllowedOrigins": [],
  "Estadisticas": {
    "TimeZone": "America/Managua",
    "SourceTimeZone": "UTC",
    "SystemUserIds": [
      1
    ],
    "SuccessStates": [
      "closed successful"
    ],
    "ExcludedQueues": [
      "Raw",
      "Postmaster",
      "Junk",
      "Misc",
      "Unidad de Administración de Servidores::trash-servidores"
    ],
    "ExcludedTitlePatterns": [
      "OTRS Scheduler Daemon Cron%"
    ],
    "ReopenWindowDays": 7,
    "BulkCloseWindowMinutes": 30,
    "ResolutionTargetHours": {
      "5 very high": 4,
      "4 high": 8,
      "3 normal": 24,
      "2 low": 48,
      "1 very low": 72
    },
    "DefaultResolutionTargetHours": 24,
    "Goals": {
      "EficaciaPercent": 90,
      "EfectividadPercent": 80,
      "NearMarginPoints": 10
    },
    "Locations": [
      {
        "Key": "RUSB",
        "Name": "Recinto Universitario Simón Bolívar",
        "QueueMatch": "RUSB",
        "Latitude": 12.13182,
        "Longitude": -86.26982
      },
      {
        "Key": "RUPAP",
        "Name": "Recinto Universitario Pedro Arauz Palacios",
        "QueueMatch": "RUPAP",
        "Latitude": 12.13611,
        "Longitude": -86.22389
      },
      {
        "Key": "DGTI",
        "Name": "DGTI · Servicios centrales",
        "QueueMatch": "",
        "Latitude": 12.13095,
        "Longitude": -86.26905
      }
    ],
    "CacheSeconds": 60
  }
}
